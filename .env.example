# OpenSky OAuth2 credentials
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_BASE_URL=https://opensky-network.org/api
OPENSKY_AUTH_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
OPENSKY_USE_MOCK_STATES=0

# Optional: mock, aviationstack, or flightaware
SCHEDULE_PROVIDER=mock

# Optional: used by future schedule provider integrations
SCHEDULE_API_KEY=

# Optional: optimizer tuning
DEFAULT_MCT_INTL_INTL=90
BUFFER_MINUTES=60
MAX_RESULTS=5
MIN_RELIABILITY=50.0

# Optional: change port
PORT=8080
